{
  "$schema": "https://opencode.ai/config.json",

  // ---------------------------------------------------------------------------
  // Ciberpensum · configuracion de OpenCode v2 (verificado contra v2.0.16)
  //
  // SINTAXIS: forma V2. La V1 usaba `permission` (objeto), accion `bash`, clave
  // `agent` y `maxSteps`. Esos NO se usan aqui. En V2:
  //   permisos  -> `permissions` (array ordenado de reglas)
  //   accion    -> `shell` (no `bash`), `subagent` (no `task`)
  //   agentes   -> `agents` (plural)
  //   pasos     -> `steps` (no `maxSteps`)
  //
  // ORDEN: gana la ULTIMA regla que coincide. Por eso la politica amplia va
  // primero y las excepciones al final. Moverlas cambia el comportamiento.
  //
  // FILOSOFIA (decidida 2026-10-05): lista de NEGATIVAS, no de preguntas.
  // Antes cada comando shell pedia confirmacion y el proyecto avanza a ritmo de
  // "once/always": en una tarde se acumulaban 30-50 cortes, y el dato publicado
  // es que el usuario aprueba el 93% de los prompts (informe citado en
  // Kilo-Org/kilocode#9138), o sea que la mayoria son ruido. Ahora manda la
  // regla `allow` y la seguridad vive en la lista de `deny` de mas abajo, que
  // son las unicas operaciones que de verdad no se pueden deshacer.
  //
  // Ademas de seguridad: `opencode --auto` (o paleta de comandos > Enable
  // auto-approve permissions) auto-aprueba lo que no este explicitamente
  // denegado, y los `deny` siguen mandando. Es la red que cubre lo que aqui no
  // prever, pero el denegado Jamas se salta.
  //
  // AVISO conocido: el schema publicado en opencode.ai/config.json sigue siendo
  // V1 y declara `additionalProperties: false`, asi que un editor puede subrayar
  // `permissions` y `agents` en rojo. Es FALSO POSITIVO: OpenCode no valida
  // contra ese schema y acepta ambas claves. Si el rojo molesta, borra la linea.
  // ---------------------------------------------------------------------------

  // Un subagente puede lanzar a otro subagente (constructor -> verificador).
  // OJO: subagent_depth a nivel raiz es LEGACY en v2 — el runtime lo omite con
  // el warning "omitted unsupported legacy setting" en opencode.log (medido el
  // 2026-10-07). El lugar valido en v2 es experimental.subagent_depth.
  "experimental": {
    "subagent_depth": 2
  },

  // Compaction (prestado de html5web, verificado contra la doc V2
  // /v2/docs/config/#compaction): sin keep.tokens, al compactar estandar queda
  // una cola corta y la sesion pierde contexto fase a fase (este proyecto lo
  // vive: compacto medio-deploy 2026-10-07, datos de prueba). keep.tokens da
  // holgura para que el detalle del trabajo sobreviva al ajuste.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 24000 }
  },

  // MCP: Playwright para verificar el sitio en un navegador real (orden de la
  // malla, bloqueo de prerrequisitos, accesibilidad) antes de publicar. Local,
  // stdin/stdout via npx; el binario de Chromium se descarga fuera del workspace.
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      }
    }
  },

  "permissions": [
    // --- politica base: permitido. Sin excepciones ocultas --------------------
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },

    // --- denegados: IRREVERSIBLES. `deny` gana siempre, ni con --auto -------
    // Historial reescrito o trabajo perdido:
    // `git push` normal SI esta permitido (la politica base de arriba). Solo se
    // nega el que reescribe historia, que es el unico que pierde trabajo.
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f *", "effect": "deny" },
    { "action": "shell", "resource": "git push *--force*", "effect": "deny" },
    { "action": "shell", "resource": "git push origin *:*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -fdx*", "effect": "deny" },
    { "action": "shell", "resource": "git checkout -- .", "effect": "deny" },
    { "action": "shell", "resource": "git rebase *", "effect": "deny" },

    // Borrado masivo (bash y PowerShell, que es lo que corre en esta maquina):
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr *", "effect": "deny" },
    { "action": "shell", "resource": "Remove-Item * -Recurse*", "effect": "deny" },
    { "action": "shell", "resource": "Remove-Item * -Recurse -Force*", "effect": "deny" },
    { "action": "shell", "resource": "del /s *", "effect": "deny" },
    { "action": "shell", "resource": "Format-Volume*", "effect": "deny" },

    // Github y credenciales: nada de borrar repos ni secretos:
    { "action": "shell", "resource": "gh repo delete*", "effect": "deny" },
    { "action": "shell", "resource": "gh secret delete*", "effect": "deny" },
    { "action": "shell", "resource": "gh auth logout*", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },

    // Secretos: no se leen ni se imprimen, ni siquiera por accidente:
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "id_rsa*", "effect": "deny" },
    { "action": "read", "resource": ".ssh/*", "effect": "deny" },
    { "action": "read", "resource": ".aws/*", "effect": "deny" },

    // --- invariantes del proyecto: el gate de verdad, no un prompt ---------
    // data/raw/ es la evidencia: su sha256 tiene que seguir siendo el del PDF
    // oficial. Se descarga con curl, no se edita a mano.
    { "action": "edit", "resource": "data/raw/*", "effect": "deny" },
    // dist/ es derivado: se regenera, no se parchea.
    { "action": "edit", "resource": "dist/*", "effect": "deny" }

    // --- ritmo: NO se anaden reglas `allow` aqui ----------------------------
    // Este es el error clasico de esta configuracion: como "gana la ultima que
    // coincide", un { shell, "git *", allow } al final REABRE lo que los `deny`
    // de arriba prohiben, y un `git push --force` pasaria sin preguntar nada.
    // La politica amplia va ARRIBA y los `deny` al final, nunca al reves.
    // Lo que se repite mucho (npm run, git *, curl.exe) ya esta permitido por la
    // politica base de las lineas de arriba; no hace falta repetirlo aqui.
  ]
}