{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ciberpensum.do/schema/pensum.schema.json",
  "title": "Pensum curado",
  "description": "Contrato de un pensum curado en data/curated/. Todo numero sale de un PDF oficial en data/raw/ y lleva fuente.url + fuente.sha256 + fuente.verificadoEn. Lo que la fuente no dice NO se inventa: se anota en `notas` o en `reglas` como NO VERIFICADO.",
  "type": "object",
  "required": ["carrera", "slug", "universidad", "grado", "version", "vigente", "duracion", "totales", "materias", "reglas", "fuente"],
  "properties": {
    "carrera": {
      "type": "string",
      "description": "Nombre oficial de la carrera tal como lo escribe el PDF."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Identificador estable para URLs y localStorage. Coincide con el nombre del archivo."
    },
    "universidad": {
      "type": "object",
      "required": ["id", "nombre"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "nombre": { "type": "string" }
      }
    },
    "grado": {
      "enum": ["grado", "postgrado"],
      "description": "grado = licenciatura/ingenieria; postgrado = maestria/especialidad."
    },
    "version": {
      "type": "string",
      "description": "Identificador de la version del pensum. Si el PDF no declara fecha, se usa la evidencia disponible y se anota la duda en `notas`."
    },
    "vigente": { "type": "boolean" },
    "duracion": {
      "type": "object",
      "required": ["periodos", "tipoPeriodo"],
      "properties": {
        "periodos": { "type": "integer", "minimum": 1 },
        "tipoPeriodo": { "enum": ["cuatrimestre", "semestre", "trimestre"] }
      }
    },
    "totales": {
      "type": "object",
      "required": ["asignaturas", "creditos"],
      "properties": {
        "asignaturas": { "type": "integer", "minimum": 1 },
        "creditos": { "type": "integer", "minimum": 1 }
      }
    },
    "materias": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["codigo", "nombre", "creditos", "cuatrimestre"],
        "properties": {
          "codigo": { "type": "string", "pattern": "^[A-Z0-9-]{3,12}$" },
          "nombre": { "type": "string", "minLength": 2 },
          "creditos": { "type": "integer", "minimum": 0 },
          "cuatrimestre": { "type": "integer", "minimum": 1 },
          "prerequisitos": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Codigos de materias que hay que aprobar antes. El gate verifica que existan y que no haya ciclos."
          },
          "desdeCuatrimestre": {
            "type": "integer",
            "minimum": 1,
            "description": "Restriccion temporal, ej. las electivas (el PDF dice '7MO. CUAT.' en la columna PRE-REQ.)."
          },
          "requiereTodas": {
            "type": "boolean",
            "description": "El PDF dice 'TODAS': hay que aprobar el resto de la carrera (INC-600)."
          },
          "observaciones": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "reglas": {
      "type": "object",
      "required": ["escala", "fuente"],
      "properties": {
        "escala": {
          "type": "object",
          "required": ["base", "minimo", "maximo", "aprobacion", "formaIndice"],
          "properties": {
            "base": { "type": "number" },
            "minimo": { "type": "number" },
            "maximo": { "type": "number" },
            "aprobacion": { "type": "number" },
            "formaIndice": {
              "enum": ["ponderado-por-creditos", "simple", "no-verificado"],
              "description": "'no-verificado' cuando el reglamento no documenta la formula de forma explicita."
            }
          }
        },
        "honores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["grado", "min", "max", "fuente"],
            "properties": {
              "grado": { "enum": ["cum-laude", "magna-cum-laude", "summa-cum-laude", "cuadro-de-honor", "otros"] },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "fuente": { "$ref": "#/definitions/fuente" }
            }
          }
        },
        "requisitosHonores": {
          "type": "object",
          "properties": {
            "sinReprobaciones": { "type": "boolean" },
            "exclusiones": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Exclusiones que cita el reglamento (ej. separacion temporal, sancion disciplinaria)."
            }
          }
        },
        "fuente": { "$ref": "#/definitions/fuente" }
      }
    },
    "notas": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Defectos o huecos de la fuente, registrados en voz alta: NO VERIFICADO / UNVERIFIABLE."
    },
    "fuente": { "$ref": "#/definitions/fuente" }
  },
  "definitions": {
    "fuente": {
      "type": "object",
      "required": ["url", "sha256", "verificadoEn"],
      "properties": {
        "url": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "verificadoEn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "archivo": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}